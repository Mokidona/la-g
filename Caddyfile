{
	admin off
	# TLS terminates on Traefik, so Caddy must not try to get certificates itself.
	auto_https off
	servers {
		trusted_proxies static private_ranges
	}
}

:80 {
	root * /srv
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		-Server
	}

	respond /healthz "ok" 200

	# Pictures never change under the same name: a week of cache is safe.
	handle /assets/* {
		header Cache-Control "public, max-age=604800"
		file_server
	}

	# HTML/CSS/JS always revalidate (304 when unchanged).
	handle {
		header Cache-Control "no-cache"
		file_server
	}
}
