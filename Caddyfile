{
	admin off
	# TLS terminates on Traefik, so Caddy must not try to get certificates itself.
	auto_https off
	servers {
		trusted_proxies static private_ranges
	}
}

:80 {
	root * /srv
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		-Server
	}

	# `handle` выполняется раньше `respond`, поэтому health-роут тоже через handle.
	handle /healthz {
		respond "ok" 200
	}

	# Pictures and fonts never change under the same name — 30 days is enough
	# for Lighthouse and still lets a replaced file reach visitors within a month.
	handle /assets/* {
		header Cache-Control "public, max-age=2592000"
		file_server
	}

	# HTML/CSS/JS always revalidate (304 when unchanged).
	handle {
		header Cache-Control "no-cache"
		file_server
	}
}
